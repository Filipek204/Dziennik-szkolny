<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" styleClass="tlo" stylesheets="@../style/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <left>
        <VBox prefWidth="240.0" spacing="10.0" styleClass="szklany-panel" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets right="20.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="30.0" />
            </padding>
            <children>
                <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="EduStrefa" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                    <padding>
                        <Insets bottom="20.0" />
                    </padding>
                </Label>

                <Button maxWidth="1.7976931348623157E308" styleClass="szklany-przycisk" text="klasy" />
                <Button maxWidth="1.7976931348623157E308" styleClass="szklany-przycisk" text="przedmioty" />
                <Button maxWidth="1.7976931348623157E308" styleClass="szklany-przycisk" text="nauczyciele" />
                <Button layoutX="26.0" layoutY="209.0" maxWidth="1.7976931348623157E308" styleClass="szklany-przycisk" text="Moje dane" />

                <Region VBox.vgrow="ALWAYS" />

                <Button maxWidth="1.7976931348623157E308" prefHeight="40.0" styleClass="wyloguj-btn" text="Wyloguj się" />
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" styleClass="szklany-panel" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label fx:id="powitanieLabel" text="Witaj [imie Nauczyciela]!" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <TableView fx:id="tabelaOcen" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-border-color: #e0e0e0; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="200.0" text="Przedmiot" />
                        <TableColumn prefWidth="300.0" text="Oceny cząstkowe" />
                        <TableColumn prefWidth="100.0" text="Średnia" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

</BorderPane>
